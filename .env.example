# Copie ce fichier en .env et remplis-le. Le vrai .env n'est jamais versionné (.gitignore).

# Obligatoire : ID client OAuth Google, type « Application Web » (voir README).
GOOGLE_CLIENT_ID="1234567890-abcdefg.apps.googleusercontent.com"

# Optionnel : clé qui signe les cookies de session. Si vide, le serveur en génère une
# et la garde dans le volume de données. La changer déconnecte tout le monde.
# Pour en générer une : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
